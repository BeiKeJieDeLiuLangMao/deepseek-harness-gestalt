exports[`MemberQuestionCard > snapshots the identity-lite banner and the folded strip 2`] = `
<div>
  <div
    class="frame"
    data-folded="true"
    data-question-key="s1:question-1"
  >
    <section
      aria-label="远端 · 成员"
      class="card cardFolded"
    >
      <button
        aria-label="远端 · 成员"
        class="foldedBar"
        type="button"
      >
        <span
          class="remoteTag"
        >
          远端
        </span>
        <span
          class="foldedSummary"
        >
          远端 · 成员
        </span>
        <span
          class="foldedMark"
        >
          已收起
        </span>
      </button>
      <div
        class="body bodyHidden"
        data-member-presentation="true"
      >
        <div
          data-question-presentation=""
          data-request-key="s1:question-1:1"
        >
          <button
            aria-expanded="false"
            aria-label="展开问题卡片"
            type="button"
          />
          <div>
            将王小明移出项目吗？
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
`;
